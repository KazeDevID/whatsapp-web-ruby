#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "optparse"
require_relative "../lib/baileys_rec"

command = ARGV.shift || "help"

case command
when "version"
  puts "baileys_rec #{BaileysRec::VERSION} (protocol parity: #{BaileysRec::PROTOCOL_PARITY})"
when "server"
  options = { port: 4567, host: "0.0.0.0", auth: "./auth_info", mode: "bridge" }
  OptionParser.new do |opts|
    opts.on("-p", "--port PORT", Integer, "HTTP server port") { |v| options[:port] = v }
    opts.on("-H", "--host HOST", String, "Bind host") { |v| options[:host] = v }
    opts.on("-a", "--auth DIR", String, "Auth folder") { |v| options[:auth] = v }
    opts.on("-m", "--mode MODE", String, "Socket mode (bridge|cloud_api|memory)") { |v| options[:mode] = v }
    opts.on("-k", "--api-key KEY", String, "Bearer API key") { |v| options[:api_key] = v }
  end.parse!(ARGV)

  sock = BaileysRec.make_wa_socket(
    mode: options[:mode].to_sym,
    auth_folder: options[:auth],
    phone_number_id: ENV["WHATSAPP_PHONE_NUMBER_ID"],
    access_token: ENV["WHATSAPP_ACCESS_TOKEN"]
  )
  sock.connect

  puts "Starting BaileysRec Automation Server on http://#{options[:host]}:#{options[:port]} (mode=#{options[:mode]})"
  BaileysRec::Automation::WebhookServer.new(
    socket: sock,
    host: options[:host],
    port: options[:port],
    api_key: options[:api_key] || ENV["BAILEYS_API_KEY"]
  ).start(blocking: true)
when "preview"
  input = ARGF.read
  payload = JSON.parse(input)
  puts JSON.pretty_generate(BaileysRec.from_cloud_api_message(payload))
else
  puts <<~HELP
    BaileysRec Ruby CLI v#{BaileysRec::VERSION}

    Commands:
      baileys-rec server [--port 4567] [--mode bridge|cloud_api|memory] [--api-key KEY]
      baileys-rec preview < cloud_api_payload.json
      baileys-rec version
  HELP
end
